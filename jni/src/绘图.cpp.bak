        const float 血量条宽度 = 1.13f * 血量;
        const float 垂直偏移 = 6.0f; 
        const ImVec2 背景左上 = {MIDDLE - 62, top - 44 + 垂直偏移};
        const ImVec2 背景右下 = {MIDDLE + 52, top - 22 + 垂直偏移};
        const ImVec2 血量左上 = {MIDDLE - 62, top - 44 + 垂直偏移};
        const ImVec2 血量右下 = {MIDDLE - 62 + 血量条宽度, top - 22 + 垂直偏移};
        const ImU32 背景颜色 = ImColor(255, 255, 255, 100);
        int teamID = 绘制.对象信息.敌人信息.队伍;
        bool isBot = 绘制.对象信息.敌人信息.isboot;
        ImColor fillColor;
        if(isBot) {
            fillColor = ImColor(255, 255, 255, 80); 
        } else {
            switch(teamID % 7) {
                case 0: fillColor = ImColor(0, 255, 0, 80); break;   
                case 1: fillColor = ImColor(0, 0, 255, 80); break;   
                case 2: fillColor = ImColor(255, 0, 255, 80); break; 
                case 3: fillColor = ImColor(255, 165, 0, 80); break; 
                case 4: fillColor = ImColor(0, 255, 255, 80); break; 
                case 5: fillColor = ImColor(255, 192, 203, 80); break; 
                default: fillColor = ImColor(255, 255, 0, 80); break; 
            }
        }
        ImGui::GetForegroundDrawList()->AddRectFilled(背景左上, 背景右下, 背景颜色, 30);
        ImGui::GetForegroundDrawList()->AddRectFilled(血量左上, 血量右下, fillColor, 30);
        ImGui::GetForegroundDrawList()->AddRect(背景左上, 背景右下, ImColor(0, 0, 0, 200), 30, 0, 1.5);
        ImVec2 topLeft = 背景左上;
