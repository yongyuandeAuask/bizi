void 绘图::绘制名字(string 名字, bool isboot, float 计时, bool 是否掐雷, char* 类名, int 阵营, int Bonecount){
    // 计算名字文本的尺寸
    string 名字显示文本 = (isboot && 阵营 != -1) ? "isBot" : 名字;
    
    if (strstr(类名, "BOSS") != 0) {
        名字显示文本 += "[BOSS]";
    }
    if(是否掐雷) {
        char buffer[50];
        float 计时保留一位小数点 = static_cast<float>(计时);
        std::sprintf(buffer, "%.1f", 计时保留一位小数点);
        名字显示文本 += " 计时-[" + std::string(buffer) + "]";
    }
    
    auto 名字文本尺寸 = ImGui::CalcTextSize(名字显示文本.c_str());
    
    // 计算名字文本的X位置（在方框上方居中）
    float 方框宽度 = right - left;
    float 方框中心X = left + 方框宽度 / 2.0f;
    float 名字位置X = 方框中心X - 名字文本尺寸.x / 2.0f;
    
    // 计算名字文本的Y位置（固定在方框上方）
    float 名字位置Y = top - 38.0f; // 保持原来的Y位置
    
    // 绘制名字背景框（如果需要）
    if (!绘制.按钮.隐藏名字背景) {
        float 名字背景框宽度 = 名字文本尺寸.x + 20.0f; // 在文本两侧各加10像素的边距
        float 名字背景框高度 = 27.0f;
        float 背景框左上X = 名字位置X - 10.0f; // 向左偏移10像素
        float 背景框左上Y = 名字位置Y - 4.0f;  // 向上偏移4像素
        float 背景框右下X = 名字位置X + 名字文本尺寸.x + 10.0f; // 向右偏移10像素
        float 背景框右下Y = 名字位置Y + 名字文本尺寸.y + 4.0f;   // 向下偏移4像素
        
        ImGui::GetBackgroundDrawList()->AddRectFilled(
            {背景框左上X, 背景框左上Y}, 
            {背景框右下X, 背景框右下Y},
            ImColor(0, 0, 0, 140), 4, 0
