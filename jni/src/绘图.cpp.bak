void 绘图::绘制手持(int 手持, int 状态, int 子弹, int 最大子弹) {
    if (绘制.按钮.手持绘图 == 1) {
        手持 = heldconversion(手持);
        if (手持图片.find(手持) != 手持图片.end()) {
            float addY = 0;
            if (绘制.按钮.血条绘图 == 1) {
                addY = 40;
            } else if (绘制.按钮.血条绘图 == 2) {
                addY = 30;
            }
            
            // 计算名字背景框的位置和尺寸
            float 名字背景框宽度 = 160.0f; // 名字背景框的宽度
            float 名字背景框高度 = 27.0f;  // 名字背景框的高度
            float 名字背景框左上X = MIDDLE - 名字背景框宽度 / 2.0f;
            float 名字背景框左上Y = top - 42.0f;
            float 名字背景框右下X = MIDDLE + 名字背景框宽度 / 2.0f;
            float 名字背景框右下Y = top - 15.0f;
            
            // 计算手持图片的位置（居中在名字背景框上方）
            float 手持图片宽度 = 75.0f * 0.7f;
            float 手持图片高度 = 35.0f * 0.7f;
            float 手持图片左上X = MIDDLE - 手持图片宽度;
            float 手持图片左上Y = 名字背景框左上Y - 手持图片高度 - 5.0f - addY; // 在名字上方5像素
            float 手持图片右下X = MIDDLE + 手持图片宽度;
            float 手持图片右下Y = 名字背景框左上Y - 5.0f - addY; // 在名字上方5像素
            
            // 绘制手持图片
            ImGui::GetForegroundDrawList()->AddImage(手持图片[手持].textureId, 
                ImVec2(手持图片左上X, 手持图片左上Y), 
                ImVec2(手持图片右下X, 手持图片右下Y), 
                ImVec2(0, 0), ImVec2(1, 1), ImColor(ImVec4(1.0f, 1.0f, 1.0f, 1.0f)));

            // 如果需要绘制手持文本（子弹数量），取消注释并调整位置
            /*
            string b = " [" + to_string(子弹) + "/" + to_string(最大子弹) + "]";
            auto textSize = ImGui::CalcTextSize(b.c_str(), 0, 20);
            ImColor color = ImColor(static_cast<int>(绘制.手持颜色[0] * 255 + 0.5), static_cast<int>(绘制.手持颜色[1] * 255 + 0.5), static_cast<int>(绘制.手持颜色[2] * 255 + 0.5), static_cast<int>(绘制.手持颜色[3] * 255 + 0.5));
            绘制加粗文本(20, MIDDLE - (textSize.x / 2), 手持图片右下Y + 5, color, color, b.c_str());
            */
        }
    } else {
        // 计算名字背景框的位置和尺寸
        float 名字背景框宽度 = 160.0f; // 名字背景框的宽度
        float 名字背景框高度 = 27.0f;  // 名字背景框的高度
        float 名字背景框左上X = MIDDLE - 名字背景框宽度 / 2.0f;
        float 名字背景框左上Y = top - 42.0f;
        
        string b = GetHolGunItem(手持);
        // b += " [" + to_string(子弹) + "/" + to_string(最大子弹) + "]";
        auto textSize = ImGui::CalcTextSize(b.c_str(), 0, 20);
        
        // 计算手持文本位置（居中在名字背景框上方）
        float 手持文本X = MIDDLE - (textSize.x / 2.0f);
        float 手持文本Y = 名字背景框左上Y - 20.0f; // 在名字上方
        
        ImColor color = ImColor(static_cast<int>(绘制.手持颜色[0] * 255 + 0.5), static_cast<int>(绘制.手持颜色[1] * 255 + 0.5), static_cast<int>(绘制.手持颜色[2] * 255 + 0.5), static_cast<int>(绘制.手持颜色[3] * 255 + 0.5));
        绘制加粗文本(20, 手持文本X, 手持文本Y, color, color, b.c_str());
    }
    string a = GetHol(状态);
    auto Size = ImGui::CalcTextSize(a.c_str(), 0, 20);
    float stateY = top - 90;  

    if (绘制.按钮.自救救人) {
        char 计算地址[256];
        sprintf(计算地址, " % lx", 状态);
        if (a == "救人") {
            auto it = rescueTimers.find(计算地址);
            if (it != rescueTimers.end()) {
                auto elapsed = std::chrono::duration_cast < std::chrono::seconds > (
                std::chrono::steady_clock::now() - it-> second
                ).count();
                if (elapsed > 6) {  
                    rescueTimers[计算地址] = std::chrono::steady_clock::now();
                }
            }
            else {
                rescueTimers[计算地址] = std::chrono::steady_clock::now();
            }
            auto& timer = rescueTimers[计算地址];
            int 剩余时间 = 10 - std::chrono::duration_cast < std::chrono::seconds > (
            std::chrono::steady_clock::now() - timer
            ).count();
            if (剩余时间 >= 0) {
                drawCountdownCircle(MIDDLE, top, 剩余时间, 10, ImColor(0, 255, 0, 255));
            }
        }
        else {
            auto it = rescueTimers.find(计算地址);
            if (it != rescueTimers.end()) {
                rescueTimers.erase(it);
            }
        }
    }
    if (绘制.按钮.手雷预警) {
        char 计算地址[256];
        sprintf(计算地址, " % lx", 状态);
        if ((手持 == 602004 || 手持 == 9825004) && a == "捏雷") {
            auto it = 捏雷Timers.find(计算地址);
            if (it != 捏雷Timers.end()) {
                auto elapsed = std::chrono::duration_cast < std::chrono::seconds > (
                std::chrono::steady_clock::now() - it-> second
                ).count();
                if (elapsed > 6) {  
                    捏雷Timers[计算地址] = std::chrono::steady_clock::now();
                }
            }
            else {
                捏雷Timers[计算地址] = std::chrono::steady_clock::now();
            }
            auto& timer = 捏雷Timers[计算地址];
            int 剩余时间 = 7 - std::chrono::duration_cast < std::chrono::seconds > (
            std::chrono::steady_clock::now() - timer
            ).count();
            if (剩余时间 >= 0) {
                drawCountdownCircle(MIDDLE, top, 剩余时间, 7, ImColor(255, 165, 0, 255));
            }
        }
        else {
            auto it = 捏雷Timers.find(计算地址);
            if (it != 捏雷Timers.end()) {
                捏雷Timers.erase(it);
            }
        }
    }
    if (绘制.按钮.自救救人) {
        char 计算地址[256];
        sprintf(计算地址, " % lx", 状态);
        if (a == "自救") {
            auto it = 自救Timers.find(计算地址);
            if (it != 自救Timers.end()) {
                auto elapsed = std::chrono::duration_cast < std::chrono::seconds > (
                std::chrono::steady_clock::now() - it-> second
                ).count();
                if (elapsed > 6) {  
                    自救Timers[计算地址] = std::chrono::steady_clock::now();
                }
            }
            else {
                自救Timers[计算地址] = std::chrono::steady_clock::now();
            }
            auto& timer = 自救Timers[计算地址];
            int 剩余时间 = 10 - std::chrono::duration_cast < std::chrono::seconds > (
            std::chrono::steady_clock::now() - timer
            ).count();
            if (剩余时间 >= 0) {
                drawCountdownCircle(MIDDLE, top, 剩余时间, 10, ImColor(0, 0, 255, 255));
            }
        }
        else {
            auto it = 自救Timers.find(计算地址);
            if (it != 自救Timers.end()) {
                自救Timers.erase(it);
            }
        }
    }
    绘制加粗文本(20, MIDDLE - (Size.x / 4), stateY, 颜色.白色, 颜色.白色, a.c_str());
    更新救人倒计时();
    更新捏雷倒计时();
    更新自救倒计时();
}
void 绘图::绘制名字(string 名字, bool isboot, float 计时, bool 是否掐雷, char* 类名, int 阵营, int Bonecount){
    // 计算名字文本的尺寸
    string 名字显示文本 = (isboot && 阵营 != -1) ? "isBot" : 名字;
    
    if (strstr(类名, "BOSS") != 0) {
        名字显示文本 += "[BOSS]";
    }
    if(是否掐雷) {
        char buffer[50];
        float 计时保留一位小数点 = static_cast<float>(计时);
        std::sprintf(buffer, "%.1f", 计时保留一位小数点);
        名字显示文本 += " 计时-[" + std::string(buffer) + "]";
    }

    auto 名字文本尺寸 = ImGui::CalcTextSize(名字显示文本.c_str());
    
    // 计算名字文本的X位置（在方框上方居中）
    float 方框宽度 = right - left;
    float 方框中心X = left + 方框宽度 / 2.0f;
    float 名字位置X = 方框中心X - 名字文本尺寸.x / 2.0f;
    
    // 计算名字文本的Y位置（固定在方框上方）
    float 名字位置Y = top - 38.0f; // 保持原来的Y位置
    
    // 绘制名字文本（不绘制背景框）
    AddTextBold(ImGui::GetBackgroundDrawList(), 16, 名字位置X, 名字位置Y, 
                ImColor(255, 255, 255, 255), ImColor(0, 0, 0, 255), 名字显示文本.c_str());
    
    // 绘制阵营数字
    std::string 阵营文本 = std::to_string((int)阵营);
    auto 阵营文本尺寸 = ImGui::CalcTextSize(阵营文本.c_str());
    float 阵营位置X = 名字位置X - 阵营文本尺寸.x - 5.0f; // 在名字文本左侧5像素
    float 阵营位置Y = 名字位置Y;
    
    AddTextBold(ImGui::GetBackgroundDrawList(), 18, 阵营位置X, 阵营位置Y, 
                ImColor(255, 255, 255, 255), ImColor(0, 0, 0, 255), 阵营文本.c_str());
}


void 绘图::绘制方框(bool isboot) {
    if (绘制.按钮.方框绘图 == 0) {
        float 缩放比例 = 0.2f;  
        float 方块边长比例 = 0.8f;  
        float 方块长度 = (right - left) * 方块边长比例 * 缩放比例;
        ImColor 方框color = ImColor(static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[0] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[1] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[2] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[3] * 255 + 0.5));
        
        ImGui::GetForegroundDrawList()->AddLine({left, top}, {left + 方块长度, top}, 方框color, 绘制.按钮.方框粗细);
        ImGui::GetForegroundDrawList()->AddLine({right, top}, {right - 方块长度, top}, 方框color, 绘制.按钮.方框粗细);
        ImGui::GetForegroundDrawList()->AddLine({left, bottom}, {left + 方块长度, bottom}, 方框color, 绘制.按钮.方框粗细);
        ImGui::GetForegroundDrawList()->AddLine({right, bottom}, {right - 方块长度, bottom}, 方框color, 绘制.按钮.方框粗细);
        ImGui::GetForegroundDrawList()->AddLine({left, top}, {left, top + 方块长度}, 方框color, 绘制.按钮.方框粗细);
        ImGui::GetForegroundDrawList()->AddLine({right, top}, {right, top + 方块长度}, 方框color, 绘制.按钮.方框粗细);
        ImGui::GetForegroundDrawList()->AddLine({left, bottom}, {left, bottom - 方块长度}, 方框color, 绘制.按钮.方框粗细);
        ImGui::GetForegroundDrawList()->AddLine({right, bottom}, {right, bottom - 方块长度}, 方框color, 绘制.按钮.方框粗细);
    } else if (绘制.按钮.方框绘图 == 1) {
        ImGui::GetForegroundDrawList()->AddRect({left, top}, {right, bottom}, 
            ImColor(static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[0] * 255 + 0.5),
            static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[1] * 255 + 0.5),
            static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[2] * 255 + 0.5),
            static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[3] * 255 + 0.5)),
            0, 0, 绘制.按钮.方框粗细);
    } else if (绘制.按钮.方框绘图 == 2) {
        ImGui::GetForegroundDrawList()->AddRect({left, top}, {right, bottom}, 
            ImColor(static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[0] * 255 + 0.5),
            static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[1] * 255 + 0.5),
            static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[2] * 255 + 0.5),
            static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[3] * 255 + 0.5)),
            0, 0, 绘制.按钮.方框粗细);
        
        float backgroundAlpha = 0.3f;  
        ImColor backgroundColor = ImColor(static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[0] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[1] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].方框颜色[2] * 255 + 0.5),
        static_cast < int > (backgroundAlpha * 255));
        
        ImGui::GetForegroundDrawList()->AddRectFilled({left, top}, {right, bottom}, backgroundColor);
    }
}

void 绘图::绘制距离(int 距离, int 队伍) {
    string 距离文本 = to_string((int)距离) + " 米";
    
    // 计算文本宽度
    float 字体大小 = 22.0f;
    float 文本宽度 = 0.0f;
    float 文本高度 = 0.0f;
    
    // 使用ImGui计算文本尺寸
    ImVec2 文本尺寸 = ImGui::CalcTextSize(距离文本.c_str());
    文本宽度 = 文本尺寸.x;
    文本高度 = 文本尺寸.y;
    
    // 计算方框宽度
    float 方框宽度 = right - left;
    
    // 计算方框中心X坐标
    float 方框中心X = left + 方框宽度 / 2.0f;
    
    // 计算距离文本的X位置（在方框下方居中）
    float 距离位置X = 方框中心X - 文本宽度 / 2.0f;
    
    // 计算距离文本的Y位置（固定在方框下方，与方框底部保持适当间距）
    float 文本与方框间距 = 3.0f;  // 文本和方框之间的间距
    float 距离位置Y = bottom + 文本与方框间距;
    
    // 注释掉原始的距离文本绘制代码，改用居中显示
    // 绘制加粗文本(字体大小, 距离位置X, 距离位置Y,
    //     ImColor(static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[0] * 255 + 0.5),
    //     static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[1] * 255 + 0.5),
    //     static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[2] * 255 + 0.5),
    //     static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[3] * 255 + 0.5)),
    //     ImColor(static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[0] * 255 + 0.5),
    //     static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[1] * 255 + 0.5),
    //     static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[2] * 255 + 0.5),
    //     static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[3] * 255 + 0.5)),
    //     距离文本.c_str());
        
    // 新的居中绘制代码
    绘制加粗文本(字体大小, 距离位置X, 距离位置Y,
        ImColor(static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[0] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[1] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[2] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[3] * 255 + 0.5)),
        ImColor(static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[0] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[1] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[2] * 255 + 0.5),
        static_cast < int > (绘制.Colorset[(int)绘制.对象信息.敌人信息.isboot].距离颜色[3] * 255 + 0.5)),
        距离文本.c_str());
}



